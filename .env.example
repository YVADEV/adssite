# Server-only iStoma production credentials. Never put these in client code.
# Do not use the demo URL or demo key from the Patient API PDF.
ISTOMA_API_BASE_URL=
ISTOMA_API_KEY=
ISTOMA_BRANCH_ID=
ISTOMA_DOCTOR_IDS=
ISTOMA_CABINET_ID=
ISTOMA_INTERVENTION_ID=
# Required for AddAppointmentRequest. Use a clinic-configured channel from GetMarketingChannels. Do not invent an ID.
ISTOMA_MARKETING_SOURCE_ID=
ISTOMA_DEFAULT_DURATION_MINUTES=60
ISTOMA_START_HOUR=9
ISTOMA_END_HOUR=21
# Keep false until the clinic authorizes a controlled live booking test.
ISTOMA_LIVE_BOOKING_ENABLED=false
ISTOMA_WEBHOOK_USER=
ISTOMA_WEBHOOK_PASSWORD=
